# ============================================================
# SmartShelf Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=smartshelf

# --- Inventory Service ---
INVENTORY_PORT=3001

# --- Forecast Service ---
FORECAST_PORT=3002

# --- Notification Service ---
NOTIFICATION_PORT=3003

# --- Order Service ---
ORDER_PORT=3004

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtts://localhost:8883
MQTT_USERNAME=smartshelf
MQTT_PASSWORD=changeme
MQTT_CA_CERT=./mqtt/certs/ca.crt

# --- AWS SQS ---
AWS_REGION=us-east-1
SQS_READINGS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/smartshelf-readings
SQS_STOCK_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/smartshelf-stock-events

# --- Simulator ---
SIM_STORES=1
SIM_SHELVES_PER_STORE=3
SIM_EVENTS_PER_SECOND=1
SIM_DURATION_SECONDS=60
SIM_INVALID_PCT=5
SIM_DUPLICATE_PCT=3
SIM_STALE_PCT=2

# --- Forecast Config ---
FORECAST_WINDOW_PERIODS=7
FORECAST_PERIOD_MINUTES=5
ORDER_COST_S=50
HOLDING_COST_H=5

# --- Node-RED ---
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=changeme
